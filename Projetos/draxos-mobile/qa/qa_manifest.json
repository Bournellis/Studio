      "timeout_seconds": 240,
      "environments": ["local", "Deno", "PowerShell 5.1+"],
      "output_policy": "read_only",
      "local_only": true
    },
    {
      "id": "client_gut_short_fast",
      "category": "fast",
      "tier": "QA",
      "lane": "godot",
      "runner": "powershell",
      "entrypoint": "tools/run_gut_short.ps1",
      "paths": [
        "res://tests/client/test_project_info.gd",
        "res://tests/client/test_session_state_facade.gd",
        "res://tests/client/test_mode_descriptor_registry.gd"
      ],
      "args": [
        "-ProjectDir",
        ".",
        "-TestPathCsv",
        "res://tests/client/test_project_info.gd,res://tests/client/test_session_state_facade.gd,res://tests/client/test_mode_descriptor_registry.gd",
        "-ExpectedTests",
        "13",
        "-ExpectedAsserts",
        "170",
        "-SkipImport"
      ],
      "profiles": ["FastSuite"],
      "timeout_seconds": 60,
      "environments": ["local", "headless", "Godot 4.6.2-stable"],
      "output_policy": "ignored_cache_only",
      "local_only": true
    },
    {
      "id": "client_quick_runtime",
      "category": "regression",
      "tier": "Runtime",
      "lane": "godot",
      "runner": "powershell",
      "entrypoint": "tools/validate_foundation.ps1",
      "args": ["-ProjectDir", ".", "-Profile", "ClientQuick"],
      "profiles": ["Runtime", "FullLocal"],
      "timeout_seconds": 300,
      "environments": ["local", "headless", "Godot 4.6.2-stable"],
      "output_policy": "ignored_cache_only",
      "local_only": true
    },
    {
      "id": "mode_platform_runtime",
      "category": "regression",
      "tier": "Runtime",
      "lane": "godot",
      "runner": "powershell",
      "entrypoint": "tools/validate_foundation.ps1",
      "args": ["-ProjectDir", ".", "-Profile", "ModePlatform"],
      "profiles": ["Runtime", "FullLocal"],
      "timeout_seconds": 240,
      "environments": ["local", "headless", "Godot 4.6.2-stable", "Deno"],
      "output_policy": "ignored_cache_only",
      "local_only": true
    },
    {
      "id": "release_dry_run_build",
      "category": "platform",
      "tier": "Build",
      "lane": "android",
      "runner": "powershell",
      "entrypoint": "tools/validate_foundation.ps1",
