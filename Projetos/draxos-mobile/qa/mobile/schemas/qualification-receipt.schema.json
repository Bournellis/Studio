{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draxosmobile.local/schemas/qualification-receipt.schema.json",
  "title": "DraxosMobile qualification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema", "created_at_utc", "project", "candidate_receipt_relative_path",
    "candidate_receipt_sha256", "artifact_sha256", "artifact_reverified_sha256",
    "qualification_kind", "result", "profile_ids", "performed_by", "evidence",
    "rebuild_performed", "publication_executed", "remote_mutation"
  ],
  "properties": {
    "receipt_schema": { "const": "draxos_mobile_qualification_receipt_v1" },
    "created_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "project": { "const": "DraxosMobile" },
    "candidate_receipt_relative_path": { "type": "string", "minLength": 1 },
    "candidate_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_reverified_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "qualification_kind": { "enum": ["visual_check", "android_check", "physical_gate"] },
    "result": { "enum": ["pass", "fail", "blocked"] },
    "profile_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" } },
    "performed_by": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relative_path", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "relative_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "rebuild_performed": { "const": false },
    "publication_executed": { "const": false },
    "remote_mutation": { "const": false }
  }
}
