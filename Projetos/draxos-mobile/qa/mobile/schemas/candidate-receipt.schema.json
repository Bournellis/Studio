{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draxosmobile.local/schemas/candidate-receipt.schema.json",
  "title": "DraxosMobile candidate receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema", "created_at_utc", "project", "channel", "source_sha",
    "artifact", "android", "toolchain", "validation", "git_snapshot_sha256",
    "remote_mutation", "published", "human_product_gate_approved"
  ],
  "properties": {
    "receipt_schema": { "const": "draxos_mobile_candidate_receipt_v1" },
    "created_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "project": { "const": "DraxosMobile" },
    "channel": { "const": "internal_alpha" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "bytes", "sha256", "export_preset", "export_mode", "release_keystore_mode"],
      "properties": {
        "kind": { "const": "android_apk" },
        "relative_path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "export_preset": { "const": "Android Alpha" },
        "export_mode": { "enum": ["release", "debug_fallback"] },
        "release_keystore_mode": { "enum": ["release", "debug_fallback"] }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_min_sdk", "resolved_target_sdk", "resolved_compile_sdk", "architectures", "orientation"],
      "properties": {
        "resolved_min_sdk": { "type": "integer", "minimum": 1 },
        "resolved_target_sdk": { "type": "integer", "minimum": 1 },
        "resolved_compile_sdk": { "type": "integer", "minimum": 1 },
        "architectures": { "const": ["arm64-v8a"] },
        "orientation": { "const": "portrait" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["godot_version", "receipt_helper"],
      "properties": {
        "godot_version": { "type": "string", "minLength": 1 },
        "receipt_helper": { "const": "mobile_candidate_receipts.py/v1" }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "report_relative_path", "report_sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "result": { "const": "pass" },
          "report_relative_path": { "type": "string", "minLength": 1 },
          "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "git_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "remote_mutation": { "const": false },
    "published": { "const": false },
    "human_product_gate_approved": { "const": false }
  }
}
