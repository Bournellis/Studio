{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estudio.local/schemas/qa_manifest.schema.json",
  "title": "Estudio project QA manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "runners", "critical_journey"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string" },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "category", "tier", "lane", "runner", "entrypoint", "args",
          "profiles", "timeout_seconds", "environments", "output_policy", "local_only"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "category": { "enum": ["fast", "regression", "visual_human", "platform", "lab", "historical"] },
          "tier": { "enum": ["QA", "Runtime", "Build"] },
          "lane": { "enum": ["godot", "web", "backend", "android", "lab"] },
          "runner": { "enum": ["godot_script", "gut_scripts", "powershell", "python", "deno", "node"] },
          "entrypoint": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "args": { "type": "array", "items": { "type": "string" } },
          "profiles": {
            "type": "array",
            "items": { "enum": ["FastSuite", "Runtime", "Build", "FullLocal"] },
            "minItems": 1,
            "uniqueItems": true
          },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "environments": { "type": "array", "items": { "type": "string" } },
          "output_policy": { "enum": ["ignored_cache_only", "temporary_only", "read_only"] },
          "local_only": { "const": true },
          "execution_resources": {
            "type": "array",
            "items": { "enum": ["GodotQA", "AndroidQA"] },
            "uniqueItems": true
          },
          "user_data_mode": { "enum": ["isolated", "shared_locked"] },
          "result_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract", "schema_version", "required"],
            "properties": {
              "marker": { "type": "string", "const": "ESTUDIO_JSON:" },
              "contract": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
              "schema_version": { "type": "integer", "minimum": 1 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "critical_journey": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "runner_ids", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
          "status": { "enum": ["covered", "manual", "gap", "not_applicable"] },
          "runner_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "string" },
          "exception": {
            "type": "object",
            "required": ["reason", "review_when"],
            "properties": {
              "reason": { "type": "string" },
              "review_when": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
