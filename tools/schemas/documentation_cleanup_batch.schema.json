{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estudio.local/schemas/documentation_cleanup_batch.schema.json",
  "title": "Estudio Documentation Lite cleanup batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "scope", "project", "baseline_commit",
    "recovery_tag", "authorization_ref", "entries", "records"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "batch_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "scope": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recovery_tag": { "type": "string", "pattern": "^recovery/estudio-documentation-lite/v2/" },
    "authorization_ref": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path", "kind", "classification", "byte_count", "line_count",
          "source_blob", "source_sha256", "disposition", "unique_content_status",
          "record_id", "retained_authorities"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["done_card", "handoff", "track", "phase", "checkpoint", "historical_document"] },
          "classification": {
            "enum": [
              "coordination_duplicate", "technical_history", "technical_contract",
              "human_gate", "publication_release", "security", "incident",
              "decision", "evidence_summary"
            ]
          },
          "byte_count": { "type": "integer", "minimum": 0 },
          "line_count": { "type": "integer", "minimum": 0 },
          "source_blob": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "disposition": {
            "enum": ["preserve_live", "preserve_reference", "preserve_evidence", "remove_with_ledger", "blocked_semantic_review"]
          },
          "unique_content_status": { "enum": ["absorbed", "none", "unresolved"] },
          "record_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
          "retained_authorities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id", "date", "scope", "outcome", "human_gate",
          "technical_result_ref", "validation", "evidence", "source_count",
          "ledger_path", "source_paths"
        ],
        "properties": {
          "record_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "scope": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "human_gate": { "type": "string", "minLength": 1 },
          "technical_result_ref": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "source_count": { "type": "integer", "minimum": 1 },
          "ledger_path": { "type": "string", "minLength": 1 },
          "source_paths": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
