{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estudio.local/schemas/documentation_removal_receipt.schema.json",
  "title": "Estudio Documentation Lite removal receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "batch_id", "baseline_commit", "recovery_tag",
    "generated_at", "index_sha256", "manifest_sha256", "entries"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "receipt_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "batch_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]+$" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recovery_tag": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "git_blob", "record_id", "ledger_path", "retained_authorities"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "git_blob": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "record_id": { "type": "string" },
          "ledger_path": { "type": "string" },
          "retained_authorities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
